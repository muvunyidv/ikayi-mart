# PostgreSQL
DATABASE_URL="postgresql://ikayi:ikayi@localhost:5432/ikayi_mart?schema=public"

# Redis (BullMQ + cache)
REDIS_URL="redis://localhost:6379"

# HTTP
PORT=3000
CORS_ORIGIN="http://localhost:8080,http://localhost:5000,http://localhost:3000,https://mart.ikayi.app"

# JWT
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Google Sign-In (OAuth 2.0 Web client ID — used to verify Flutter ID tokens)
GOOGLE_CLIENT_ID=""

# Cloudinary (required — product images are streamed here, not saved to disk)
CLOUDINARY_CLOUD_NAME="dv5peyrzr"
CLOUDINARY_API_KEY="856972281186289"
CLOUDINARY_API_SECRET="zPyA9blW8LCSOE1sfv4ZA9Yz990"

# Rwanda commerce
DEFAULT_DELIVERY_FEE_RWF=2000
STOCK_HOLD_TTL_SECONDS=900

# Payments: mock | production
# mock = pay button confirms immediately and returns a tracking code (for testing the flow)
# production = real MTN MoMo / Airtel Money prompts + webhooks
PAYMENT_MODE="mock"
WEBHOOK_SECRET="dev-webhook-secret"

# MTN MoMo Open API (used when PAYMENT_MODE=production)
MTN_MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
MTN_MOMO_TARGET_ENV="sandbox"

# Airtel Money Open API (used when PAYMENT_MODE=production)
AIRTEL_BASE_URL="https://openapiuat.airtel.africa"
AIRTEL_CLIENT_ID=""
AIRTEL_CLIENT_SECRET=""
